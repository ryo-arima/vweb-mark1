# PostgreSQL bootstrap values for local development.
POSTGRES_USER=vweb
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=postgres
VWEB_KEYCLOAK_DB_PASSWORD=replace-with-a-keycloak-password
VWEB_SERVICE_DB_PASSWORD=replace-with-a-service-password
VWEB_BFF_DB_PASSWORD=replace-with-a-bff-session-password
VWEB_ROUNDCUBE_DB_PASSWORD=replace-with-a-roundcube-password
VWEB_DNS_HTTP_PASSWORD=replace-with-a-dns-diagnostics-password
VWEB_MAIL_ADDRESS=dev@vweb.local
VWEB_MAIL_PASSWORD=replace-with-a-development-mail-password

# Keycloak administrator bootstrap values.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-keycloak-admin-password
KEYCLOAK_SAMPLE_USER_PASSWORD=replace-with-a-development-only-sample-password
KEYCLOAK_BFF_CLIENT_SECRET=replace-with-a-development-only-bff-client-secret
KEYCLOAK_SERVICE_A_CLIENT_SECRET=replace-with-a-development-only-service-a-api-secret
KEYCLOAK_SERVICE_B_CLIENT_SECRET=replace-with-a-development-only-service-b-api-secret
VWEB_PUBLIC_URL=https://vweb.local
KEYCLOAK_PUBLIC_URL=https://vweb.local/auth
KEYCLOAK_TRUSTSTORE_PASSWORD=replace-with-a-truststore-password

# step-ca bootstrap password. Keep the value outside version control.
STEP_CA_INIT_PASSWORD=replace-with-a-step-ca-password

# Reserved for the server-side BFF session encryption implementation.
SESSION_ENCRYPTION_KEY=replace-with-a-32-byte-session-key
